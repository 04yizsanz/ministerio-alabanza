# ──────────────────────────────────────────────────────────────────────────────
# Variables de entorno — Sistema de Gestión del Ministerio de Alabanza
#
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
#
# NUNCA subas el .env real al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de datos ──────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=cambia_esto_en_produccion
DB_DATABASE=ministerio_alabanza
DB_USERNAME=ministerio_user
DB_PASSWORD=cambia_esto_en_produccion
DB_PORT=3306

# ── Laravel ────────────────────────────────────────────────────────────────────
# Generar con: php artisan key:generate --show
APP_KEY=base64:GENERA_UNA_CLAVE_AQUI

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# ── Sanctum SPA ────────────────────────────────────────────────────────────────
# Dominio del frontend (sin protocolo)
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# ── Frontend ───────────────────────────────────────────────────────────────────
# URL pública del backend (para el build de producción con Docker)
VITE_API_URL=http://localhost:8000
